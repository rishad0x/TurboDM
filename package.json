{
  "name": "turbodm",
  "version": "1.0.0",
  "description": "TurboDM - Ultra-Fast Multi-Threaded Download Manager by Rishad",
  "main": "main.js",
  "type": "module",
  "author": "Rishad (https://github.com/rishad0x)",
  "homepage": "https://github.com/rishad0x",
  "license": "PolyForm-Noncommercial-1.0.0",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "predist": "bun scripts/brand-exe.js",
    "dist": "electron-builder",
    "test": "bun test",
    "postinstall": "bun scripts/postinstall.js"
  },
  "trustedDependencies": [
    "electron",
    "ffmpeg-static"
  ],
  "build": {
    "appId": "com.rishad.turbodm",
    "productName": "TurboDM",
    "electronDist": "node_modules/electron/dist",
    "files": [
      "main.js",
      "preload.js",
      "engine/**/*",
      "public/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TurboDM",
      "artifactName": "TurboDM-Setup-${version}.${ext}",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "include": "build/installer.nsh"
    }
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
